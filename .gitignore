# Regenerable, and large. The manifests carry the sha256 of each, so the
# reproducibility contract holds without committing 40 MB:
#   python src/chunker.py --budget 600
#   curl -sL -o data/multihoprag_corpus.parquet <hf url>
data/*.parquet
data/*.jsonl
data/qwen3_tokenizer.json
.venv/
__pycache__/
models/
data/thai/iapp.zip
